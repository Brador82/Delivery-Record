<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="?attr/actionBarSize"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInvoiceImage"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/charcoal"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/rich_gold"
            app:strokeWidth="1dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivInvoiceImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/original_invoice"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/rich_gold"
                    android:background="@color/dark_charcoal"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tap_to_extract"
                    android:textAlignment="center"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/invoice_number">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etInvoiceNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/customer_name">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/address"
            app:endIconContentDescription="Navigate to address"
            app:endIconDrawable="@drawable/ic_navigate"
            app:endIconMode="custom"
            app:endIconTint="@color/gold">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="2"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/phone"
            app:endIconContentDescription="Call customer"
            app:endIconDrawable="@drawable/ic_phone"
            app:endIconMode="custom"
            app:endIconTint="@color/gold">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/items"/>
        <TextView
            android:id="@+id/tvSelectedItems"
            android:background="@android:drawable/edit_text"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_items"/>
        <TextView
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/pod_photo"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:background="@android:color/darker_gray"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/ivPod1"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="POD 1"/>
            </FrameLayout>
            <FrameLayout
                android:background="@android:color/darker_gray"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/ivPod2"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="POD 2"/>
            </FrameLayout>
            <FrameLayout
                android:background="@android:color/darker_gray"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/ivPod3"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="POD 3"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <FrameLayout
                android:background="@android:color/darker_gray"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/ivPod4"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="POD 4"/>
            </FrameLayout>
            <FrameLayout
                android:background="@android:color/darker_gray"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/ivPod5"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="POD 5"/>
            </FrameLayout>
            <FrameLayout
                android:background="@android:color/darker_gray"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/ivPod6"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="POD 6"/>
            </FrameLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/btnCapturePOD"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_pod"/>
        <TextView
            android:textSize="16sp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/signature"/>
        <FrameLayout
            android:background="@android:color/darker_gray"
            android:layout_width="match_parent"
            android:layout_height="150dp">
            <ImageView
                android:id="@+id/ivSignature"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Signature"/>
            <com.google.android.material.button.MaterialButton
                android:layout_gravity="center"
                android:id="@+id/btnCaptureSignature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_signature"/>
        </FrameLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/notes">
            <com.google.android.material.textfield.TextInputEditText
                android:gravity="top"
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="64dp"
            android:text="Save Changes"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
