<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_delivery"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/view_status_indicator"
            android:background="@color/primary"
            android:layout_width="4dp"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_priority"
                    android:visibility="gone"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_priority"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:ellipsize="end"
                    android:id="@+id/tv_customer_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="John Doe"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:id="@+id/tv_status"
                    android:background="@drawable/bg_status_badge"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:ellipsize="end"
                android:id="@+id/tv_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="123 Main St, New York, NY 10001"
                android:maxLines="2"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_location"
                android:drawableTint="@android:color/darker_gray"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="@android:color/darker_gray"
                android:id="@+id/tv_tracking_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="DEL-20260128-12345"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_tracking"
                android:drawableTint="@android:color/darker_gray"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:id="@+id/tv_time_window"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="09:00 - 12:00"
                    android:drawablePadding="6dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_time"
                    android:drawableTint="@color/primary"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@android:color/darker_gray"
                    android:id="@+id/tv_package_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 packages"
                    android:drawablePadding="6dp"
                    android:drawableStart="@drawable/ic_package"
                    android:layout_marginStart="16dp"
                    android:drawableTint="@android:color/darker_gray"/>
                <ImageView
                    android:id="@+id/iv_phone"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_phone"
                    android:tint="@color/primary"
                    android:layout_marginStart="16dp"/>
                <ImageView
                    android:id="@+id/iv_navigate"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_navigate"
                    android:tint="@color/primary"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
