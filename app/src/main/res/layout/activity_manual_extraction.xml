<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/rich_black"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/medium_tan"
        android:id="@+id/tvHint"
        android:background="@color/dark_charcoal"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/draw_selection_hint"
        android:textAlignment="center"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/dark_charcoal"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRotateLeft"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Rotate L"
            android:textSize="11sp"
            android:textColor="@color/champagne"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"
            app:icon="@android:drawable/ic_menu_rotate"
            app:iconTint="@color/champagne"
            app:iconSize="16dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRotateRight"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Rotate R"
            android:textSize="11sp"
            android:textColor="@color/champagne"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"
            app:icon="@android:drawable/ic_menu_rotate"
            app:iconTint="@color/champagne"
            app:iconSize="16dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrop"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Crop"
            android:textSize="11sp"
            android:textColor="@color/champagne"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:icon="@android:drawable/ic_menu_crop"
            app:iconTint="@color/champagne"
            app:iconSize="16dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>
    </LinearLayout>
    <com.mobileinvoice.ocr.SelectionOverlayView
        android:id="@+id/selectionOverlay"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:orientation="horizontal"
        android:background="@color/rich_black"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/gold"
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Reset"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:strokeColor="@color/rich_gold"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="@color/rich_black"
            android:id="@+id/btnDone"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Done"
            android:layout_weight="1"
            app:backgroundTint="@color/rich_gold"/>
    </LinearLayout>
</LinearLayout>
