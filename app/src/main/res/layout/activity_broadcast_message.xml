<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#1a1a1a"
    android:paddingTop="?attr/actionBarSize"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#d4af37"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Broadcast to Customers"/>
        <TextView
            android:textSize="13sp"
            android:textColor="#aaaaaa"
            android:id="@+id/tvSubtitle"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preparing route data..."/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/loadingSection"
            android:padding="24dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#d4af37"
                android:id="@+id/tvLoadingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculating route and ETAs..."/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/contentSection"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="#333333"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#d4af37"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Message Preview (1st customer)"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#f7e7ce"
                android:id="@+id/tvPreview"
                android:background="#222222"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"/>
            <View
                android:background="#333333"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#d4af37"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Delivery Sequence"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap AM·PM to assign"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/customerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.button.MaterialButton
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnSendAM"
                    android:background="@drawable/button_gradient_optimize"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:text="SEND AM (0)"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:backgroundTint="@null"
                    app:cornerRadius="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1a1a1a"
                    android:id="@+id/btnSendPM"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:text="SEND PM (0)"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#d4af37"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/sendingProgress"
                android:paddingTop="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="#d4af37"
                    android:id="@+id/tvSendingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sending..."/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
