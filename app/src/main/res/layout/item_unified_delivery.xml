<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="1dp"
    app:cardBackgroundColor="#1a1a1a"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/gradient_card_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/mainContent"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1a1a1a"
                android:gravity="center"
                android:id="@+id/tvLetterBadge"
                android:background="@drawable/circle_background_gold"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="A"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="11sp"
                    android:textColor="#999999"
                    android:id="@+id/tvInvoiceNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INV-123456"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#d4af37"
                    android:ellipsize="end"
                    android:id="@+id/tvCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Customer Name"
                    android:maxLines="1"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    android:id="@+id/tvAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="123 Main Street, City, ST 12345"
                    android:maxLines="2"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#d4af37"
                    android:id="@+id/tvViewDetails"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="VIEW DETAILS"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/etaRow"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#ffd700"
                        android:id="@+id/tvETA"
                        android:background="@drawable/badge_eta"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETA: 10:30 AM"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#999999"
                        android:id="@+id/tvStopTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(30 min stop)"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#1a1a1a"
                        android:id="@+id/tvPriorityBadge"
                        android:background="@drawable/badge_priority"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FIRST"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/actionButtonsColumn"
                android:visibility="gone"
                android:layout_width="52dp"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/btnCall"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_call"
                    android:contentDescription="Call customer"
                    app:layout_constraintBottom_toTopOf="@+id/btnNavigate"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="spread"
                    app:tint="#4caf50"/>
                <ImageButton
                    android:id="@+id/btnNavigate"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_directions"
                    android:contentDescription="Navigate to this stop"
                    app:layout_constraintBottom_toTopOf="@+id/cbCompleted"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnCall"
                    app:tint="#2196f3"/>
                <CheckBox
                    android:id="@+id/cbCompleted"
                    android:background="@drawable/checkbox_completed"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="4dp"
                    android:button="@null"
                    android:contentDescription="Mark delivery completed"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:layout_width="36dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp">
                <ImageButton
                    android:id="@+id/btnExpand"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:visibility="gone"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:contentDescription="Expand options"
                    app:tint="#d4af37"/>
                <ImageView
                    android:id="@+id/dragHandle"
                    android:padding="4dp"
                    android:visibility="gone"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:contentDescription="Drag to reorder"
                    app:tint="#888888"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/etaRowContainer"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="68dp"
            android:paddingEnd="12dp">
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#ffd700"
                android:id="@+id/tvETABottom"
                android:background="@drawable/badge_eta"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ETA: 10:30 AM"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#999999"
                android:id="@+id/tvStopTimeBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(30 min stop)"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#1a1a1a"
                android:id="@+id/tvPriorityBadgeBottom"
                android:background="@drawable/badge_priority"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIRST"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <ImageButton
                android:id="@+id/btnDelete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Delete delivery"
                app:tint="#d32f2f"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/expandablePanel"
            android:background="#0d0d0d"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <View
                android:background="#333333"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery Priority"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <Button
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnMakeFirst"
                    android:background="@drawable/button_priority_first"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:text="Make First"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginEnd="4dp"
                    android:elevation="2dp"/>
                <Button
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnMakeLast"
                    android:background="@drawable/button_priority_last"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:text="Make Last"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:elevation="2dp"/>
                <Button
                    android:textSize="12sp"
                    android:textColor="#cccccc"
                    android:id="@+id/btnClearPriority"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:text="Clear"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#444444"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Estimated Stop Time"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#d4af37"
                android:gravity="center"
                android:id="@+id/tvStopTimeValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="30 minutes"/>
            <SeekBar
                android:id="@+id/seekBarStopTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:max="7"
                android:progress="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:progressTint="#d4af37"
                android:progressBackgroundTint="#555555"
                android:thumbTint="#d4af37"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp">
                <TextView
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:gravity="start"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="15m"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="30m"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="1hr"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="1h30"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:gravity="end"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="2hr"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
