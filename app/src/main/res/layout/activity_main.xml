<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/themeActivityBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeColor="?attr/themeSectionBorderColor"
                app:strokeWidth="1dp"
                style="@style/CardStyle">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="?attr/themeSectionBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gold"
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Broadcast Message"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/warm_gray"
                        android:paddingBottom="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Send delivery notifications to all customers on today&apos;s route"/>
                    <com.google.android.material.button.MaterialButton
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/themeButtonTextColor"
                        android:id="@+id/btnBroadcast"
                        android:background="?attr/themeButtonBackground"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Broadcast to Customers"
                        app:backgroundTint="@null"
                        app:icon="@android:drawable/ic_dialog_email"
                        app:iconTint="@color/gold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeColor="?attr/themeSectionBorderColor"
                app:strokeWidth="1dp"
                style="@style/CardStyle">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="?attr/themeSectionBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gold"
                        android:paddingBottom="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Invoice Upload &amp; Capture"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpload"
                            android:background="?attr/themeButtonBackground"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Upload"
                            android:layout_weight="1"
                            app:backgroundTint="@null"
                            app:icon="@drawable/ic_upload_file"
                            app:iconTint="@color/gold"
                            style="@style/ButtonStyle"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCamera"
                            android:background="?attr/themeButtonBackground"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Camera"
                            android:layout_weight="1"
                            app:backgroundTint="@null"
                            app:icon="@android:drawable/ic_menu_camera"
                            app:iconTint="@color/gold"
                            style="@style/ButtonStyle"/>
                    </LinearLayout>
                    <TextView
                        android:textColor="@color/medium_gray"
                        android:padding="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/drag_drop_hint"
                        android:textAlignment="center"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/imagePreviewRecycler"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <com.google.android.material.button.MaterialButton
                        android:enabled="false"
                        android:textStyle="bold"
                        android:textColor="?attr/themeButtonTextColor"
                        android:id="@+id/btnProcessOCR"
                        android:background="?attr/themeButtonBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Process All with OCR"
                        app:backgroundTint="@null"
                        app:icon="@drawable/ic_scan_document"
                        app:iconTint="@color/gold"/>
                    <com.google.android.material.button.MaterialButton
                        android:textColor="#d32f2f"
                        android:layout_gravity="center"
                        android:id="@+id/btnClearQueue"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Clear Queue"
                        style="@style/Widget.Material3.Button.TextButton"/>
                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        style="?android:attr/progressBarStyleHorizontal"/>
                    <TextView
                        android:id="@+id/tvProgress"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAlignment="center"/>
                    <TextView
                        android:textColor="@color/primary"
                        android:id="@+id/tvStatus"
                        android:padding="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ready. Upload or capture invoice images."
                        android:textAlignment="center"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeColor="?attr/themeSectionBorderColor"
                app:strokeWidth="1dp"
                style="@style/CardStyle">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="?attr/themeSectionBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/gold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delivery Records"
                            android:layout_centerVertical="true"
                            android:layout_alignParentStart="true"/>
                        <ImageButton
                            android:id="@+id/btnInvoiceLibraryIcon"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_delivery_records"
                            android:layout_centerVertical="true"
                            android:contentDescription="@string/invoice_library"
                            android:layout_alignParentEnd="true"
                            app:tint="@color/gold"/>
                    </RelativeLayout>
                    <TextView
                        android:id="@+id/tvRecordCount"
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/no_records"/>
                    <com.google.android.material.button.MaterialButton
                        android:textColor="?attr/themeButtonTextColor"
                        android:id="@+id/btnInvoiceLibrary"
                        android:background="?attr/themeButtonBackground"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/invoice_library"
                        app:backgroundTint="@null"
                        app:icon="@drawable/ic_delivery_records"
                        app:iconTint="@color/gold"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/invoiceRecycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeColor="?attr/themeSectionBorderColor"
                app:strokeWidth="1dp"
                style="@style/CardStyle">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="?attr/themeSectionBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gold"
                        android:paddingBottom="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Export &amp; Share"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportCSV"
                            android:background="?attr/themeButtonBackground"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/export_csv"
                            android:layout_weight="1"
                            app:backgroundTint="@null"
                            app:icon="@drawable/ic_export"
                            app:iconTint="@color/gold"
                            style="@style/ButtonStyle"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportMarkdown"
                            android:background="?attr/themeButtonBackground"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Save to Storage"
                            android:layout_weight="1"
                            app:backgroundTint="@null"
                            app:icon="@drawable/ic_export"
                            app:iconTint="@color/gold"
                            style="@style/ButtonStyle"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeColor="?attr/themeSectionBorderColor"
                app:strokeWidth="1dp"
                style="@style/CardStyle">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="?attr/themeSectionBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/gold"
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Route Optimization"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/warm_gray"
                        android:paddingBottom="16dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Calculate the most efficient delivery route"/>
                    <com.google.android.material.button.MaterialButton
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/themeButtonTextColor"
                        android:id="@+id/btnOptimizeRoute"
                        android:background="?attr/themeButtonBackground"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Optimize Delivery Route"
                        app:backgroundTint="@null"
                        app:icon="@drawable/ic_delivery_truck"
                        app:iconTint="@color/gold"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_gravity="end|bottom"
        android:id="@+id/fabSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:contentDescription="Settings"
        app:backgroundTint="#d4af37"
        app:fabSize="mini"
        app:tint="@color/black"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
