<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#1a1a1a"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/gradient_card_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/mainContent"
            android:background="?attr/selectableItemBackground"
            android:padding="12dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1a1a1a"
                android:gravity="center"
                android:id="@+id/tvStopNumber"
                android:background="@drawable/circle_background_gold"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="1"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#d4af37"
                    android:id="@+id/tvCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Customer Name"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="#ffffff"
                    android:ellipsize="end"
                    android:id="@+id/tvAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="123 Main Street, City, ST 12345"
                    android:maxLines="2"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="#cccccc"
                    android:id="@+id/tvStopInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Items: Washer, Dryer"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#ffd700"
                        android:id="@+id/tvETA"
                        android:background="@drawable/badge_eta"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ETA: 10:30 AM"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#999999"
                        android:id="@+id/tvStopTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(30 min stop)"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#1a1a1a"
                        android:id="@+id/tvPriorityBadge"
                        android:background="@drawable/badge_priority"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FIRST"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <ImageButton
                    android:id="@+id/btnCall"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@android:drawable/ic_menu_call"
                    android:contentDescription="Call customer"
                    app:tint="#4caf50"/>
                <ImageButton
                    android:id="@+id/btnNavigate"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:src="@android:drawable/ic_menu_directions"
                    android:contentDescription="Navigate to this stop"
                    app:tint="#2196f3"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp">
                <ImageButton
                    android:id="@+id/btnExpand"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/arrow_down_float"
                    android:contentDescription="Expand options"
                    app:tint="#d4af37"/>
                <ImageView
                    android:id="@+id/dragHandle"
                    android:padding="4dp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:contentDescription="Drag to reorder"
                    app:tint="#888888"/>
                <CheckBox
                    android:id="@+id/cbCompleted"
                    android:background="@drawable/checkbox_completed"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:button="@null"
                    android:contentDescription="Mark delivery completed"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/expandablePanel"
            android:background="#0d0d0d"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <View
                android:background="#333333"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delivery Priority"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <Button
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnMakeFirst"
                    android:background="@drawable/button_priority_first"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:text="↑ Make First"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginEnd="8dp"
                    android:elevation="2dp"/>
                <Button
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnMakeLast"
                    android:background="@drawable/button_priority_last"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:text="↓ Make Last"
                    android:layout_weight="1"
                    android:textAllCaps="false"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#999999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Estimated Stop Time"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <ImageButton
                    android:id="@+id/btnDecreaseTime"
                    android:background="@drawable/button_time_adjust"
                    android:padding="8dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_time_subtract"
                    android:scaleType="centerInside"
                    android:contentDescription="Decrease stop time"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#d4af37"
                    android:gravity="center"
                    android:id="@+id/tvStopTimeValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="30 minutes"
                    android:layout_weight="1"/>
                <ImageButton
                    android:id="@+id/btnIncreaseTime"
                    android:background="@drawable/button_time_adjust"
                    android:padding="8dp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_time_add"
                    android:scaleType="centerInside"
                    android:contentDescription="Increase stop time"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <Button
                    android:textSize="11sp"
                    android:textColor="#cccccc"
                    android:id="@+id/btnTime15"
                    android:background="@drawable/button_time_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="48dp"
                    android:text="15m"
                    android:textAllCaps="false"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#d4af37"
                    android:id="@+id/btnTime30"
                    android:background="@drawable/button_time_preset_selected"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="48dp"
                    android:text="30m"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#cccccc"
                    android:id="@+id/btnTime45"
                    android:background="@drawable/button_time_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="48dp"
                    android:text="45m"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#cccccc"
                    android:id="@+id/btnTime60"
                    android:background="@drawable/button_time_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="48dp"
                    android:text="1hr"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#cccccc"
                    android:id="@+id/btnTime90"
                    android:background="@drawable/button_time_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="48dp"
                    android:text="1.5hr"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp"/>
                <Button
                    android:textSize="11sp"
                    android:textColor="#cccccc"
                    android:id="@+id/btnTime120"
                    android:background="@drawable/button_time_preset"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="48dp"
                    android:text="2hr"
                    android:textAllCaps="false"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
