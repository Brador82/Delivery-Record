<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#1a1a1a"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="#222222"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.65">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#d4af37"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date:"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/tvDeliveryDate"
                android:background="@drawable/underline_white"
                android:paddingBottom="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MM/DD/YYYY"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="8dp"/>
            <View
                android:layout_width="24dp"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#d4af37"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customer:"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:ellipsize="end"
                android:id="@+id/tvCustomerName"
                android:background="@drawable/underline_white"
                android:paddingBottom="2dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Customer Name"
                android:singleLine="true"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#d4af37"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Customer Signature:"/>
        <com.mobileinvoice.ocr.SignatureView
            android:id="@+id/signatureCanvas"
            android:background="@drawable/signature_canvas_bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#888888"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✕ Sign above"
            android:textAlignment="center"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.button.MaterialButton
                android:textColor="#ffffff"
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="Clear"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:strokeColor="#d4af37"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/btnSave"
                android:background="@drawable/button_gradient_optimize"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:text="Accept &amp; Save"
                android:layout_weight="1"
                app:backgroundTint="@null"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="#d4af37"
        android:layout_width="match_parent"
        android:layout_height="2dp"/>
    <ScrollView
        android:background="#0d0d0d"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#d4af37"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DELIVERY ACCEPTANCE SIGN OFF"
                android:textAlignment="center"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#cccccc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Customer or person(s) over the age of 18 present upon delivery &amp; installation of appliances, and agree to accepting are installed correctly without any harm to the home.\10\102. Customer or person(s) over the age of 18 was present for delivery and installation agrees that appliances, a test run/overview was provided, no damages were noted &amp; that they were installed correctly without any damage arising to the house or appliance from the use of customers old appliance hoses, and/or improperly maintained or damaged faucets/drains/valves, etc."
                android:lineSpacingExtra="4dp"/>
            <View
                android:background="#333333"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#d4af37"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TERMS AND CONDITIONS"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#aaaaaa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scratch and Dent Goods:\10• All delivery sales are final. There is no return or refund on scratch or dent product, unless such item is non-repairable. Purchaser is solely responsible for appliance(s) back to the store for goods exchange.\10• Allow delivery drivers to leave if there is an issue on arrival. Claims to cash refund. Payment to the customer will be returned according to the customers Payment method of customer need deliver back up the returned goods at owner&apos;s time, not your driver during the the delivery time that my and cause issues."
                android:lineSpacingExtra="3dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#aaaaaa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Warranty:\10• Warranty must begin within 30 days after delivery by contacting the manufacturer or call 800-905-0443. Instructions are found in the pamphlet and warranty sticker.\10• Customer is responsible for calling the customer care as soon as any issue arises within the warranty period.\10• After 30 days - Customer is still responsible for repair issues and delivery/pickup, and labor. Warranty Exceptions are found in the pamphlet. Please read it carefully to see if it applies to your situation.\10• Warranty does not cover negligence, power surges, or pest infestation."
                android:lineSpacingExtra="3dp"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="italic"
                android:textColor="#888888"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="S/N - which is the #/# on the machine, or other unique numbers as the store ref."/>
            <TextView
                android:textSize="11sp"
                android:textColor="#d4af37"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Please refer to www.ccsarms.com or call 800-905-0443 for warranty registration."
                android:textAlignment="center"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
