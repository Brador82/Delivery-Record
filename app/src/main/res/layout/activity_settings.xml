<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/themeActivityBackground"
    android:paddingTop="?attr/actionBarSize"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextAccent"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="��  PROFILE"
            android:letterSpacing="0.08"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCompanyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Company Name"
                    app:boxStrokeColor="?attr/themeTextAccent"
                    app:hintTextColor="?attr/themeTextAccent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/etCompanyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"/>
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWarehouseAddress"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:hint="Warehouse / Home Base Address"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:boxStrokeColor="?attr/themeTextAccent"
                        app:hintTextColor="?attr/themeTextAccent"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                        <com.google.android.material.textfield.TextInputEditText
                            android:textColor="?android:attr/textColorPrimary"
                            android:id="@+id/etWarehouseAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:textSize="11sp"
                        android:textColor="?attr/colorOnSecondary"
                        android:id="@+id/btnGeocode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GEOCODE"
                        android:backgroundTint="?attr/themeTextAccent"
                        app:cornerRadius="6dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:id="@+id/tvGeoResult"
                    android:paddingTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextAccent"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="��  ROUTE &amp; DELIVERY"
            android:letterSpacing="0.08"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ETA Window"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp">
                    <Button
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSecondary"
                        android:id="@+id/btnEta15"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:text="15 min"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="?attr/themeTextAccent"/>
                    <Button
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSecondary"
                        android:id="@+id/btnEta30"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:text="30 min"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="?attr/themeTextAccent"/>
                    <Button
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSecondary"
                        android:id="@+id/btnEta45"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:text="45 min"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:backgroundTint="?attr/themeTextAccent"/>
                    <Button
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSecondary"
                        android:id="@+id/btnEta60"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:text="60 min"
                        android:layout_weight="1"
                        android:backgroundTint="?attr/themeTextAccent"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Default Service Type"/>
                <Spinner
                    android:textColor="?android:attr/textColorPrimary"
                    android:id="@+id/spinnerServiceType"
                    android:background="@drawable/bg_mirror_card"
                    android:padding="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextAccent"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="��  APPEARANCE"
            android:letterSpacing="0.08"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Theme — tap to apply (app restarts)"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/chipDarkMarble"
                        android:background="@drawable/bg_imperial_marble_card"
                        android:padding="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp">
                        <View
                            android:background="#d4af37"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>
                        <TextView
                            android:textSize="10sp"
                            android:textColor="#d4af37"
                            android:gravity="center"
                            android:paddingTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dark"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#d4af37"
                            android:id="@+id/tvChipDarkMarbleCheck"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/chipLightMarble"
                        android:background="@drawable/bg_marble_card"
                        android:padding="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp">
                        <View
                            android:background="#8b6914"
                            android:layout_width="28dp"
                            android:layout_height="28dp"/>
                        <TextView
                            android:textSize="10sp"
                            android:textColor="#8b6914"
                            android:gravity="center"
                            android:paddingTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Light"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#8b6914"
                            android:id="@+id/tvChipLightMarbleCheck"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/chipBlended"
                        android:background="@drawable/bg_imperial_marble_card"
                        android:padding="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <View
                            android:background="#0c090a"
                            android:layout_width="28dp"
                            android:layout_height="14dp"/>
                        <View
                            android:background="#f5f5f0"
                            android:layout_width="28dp"
                            android:layout_height="14dp"/>
                        <TextView
                            android:textSize="10sp"
                            android:textColor="#d4af37"
                            android:gravity="center"
                            android:paddingTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blended"/>
                        <TextView
                            android:textSize="14sp"
                            android:textColor="#d4af37"
                            android:id="@+id/tvChipBlendedCheck"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextAccent"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="��  STORAGE &amp; EXPORT"
            android:letterSpacing="0.08"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilExportFolder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Export Folder Name (in Downloads/)"
                    app:boxStrokeColor="?attr/themeTextAccent"
                    app:hintTextColor="?attr/themeTextAccent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/etExportFolder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextAccent"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☁  CLOUD SYNC"
            android:letterSpacing="0.08"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:id="@+id/tvDriveStatus"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Not connected"/>
                <com.google.android.material.button.MaterialButton
                    android:textColor="?attr/colorOnSecondary"
                    android:id="@+id/btnDriveConnect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="CONNECT GOOGLE DRIVE"
                    android:backgroundTint="?attr/themeTextAccent"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextAccent"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅  AFTER DELIVERY"
            android:letterSpacing="0.08"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="When a delivery is marked complete:"/>
                <RadioGroup
                    android:orientation="vertical"
                    android:id="@+id/rgAfterDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/rbAfterAsk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ask every time"
                        android:buttonTint="?attr/themeTextAccent"/>
                    <RadioButton
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/rbAfterArchive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Auto-archive silently"
                        android:buttonTint="?attr/themeTextAccent"/>
                    <RadioButton
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/rbAfterNavigate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Archive and navigate to next stop"
                        android:buttonTint="?attr/themeTextAccent"/>
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextAccent"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CUSTOMER MESSAGING"
            android:letterSpacing="0.08"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <TextView
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Send follow-up on delivery complete"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchFollowUp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Delivery Team Name"
                    app:boxStrokeColor="?attr/themeTextAccent"
                    app:hintTextColor="?attr/themeTextAccent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/etDeliveryTeamName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:textSize="12sp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Google Review URL"
                    app:boxStrokeColor="?attr/themeTextAccent"
                    app:hintTextColor="?attr/themeTextAccent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/etGoogleReviewUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:textSize="12sp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Suggested Review (customer can copy/paste)"
                    app:boxStrokeColor="?attr/themeTextAccent"
                    app:hintTextColor="?attr/themeTextAccent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/etSuggestedReview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textSize="12sp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Placeholders: {name}  {company}  {items}  {team}  {review_url}  {review_text}"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Follow-Up Message"
                    app:boxStrokeColor="?attr/themeTextAccent"
                    app:hintTextColor="?attr/themeTextAccent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/etBroadcastMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:textSize="12sp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:hint="Quick Message 1"
                    app:boxStrokeColor="?attr/themeTextAccent"
                    app:hintTextColor="?attr/themeTextAccent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/etCustomMessage1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textSize="12sp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Quick Message 2"
                    app:boxStrokeColor="?attr/themeTextAccent"
                    app:hintTextColor="?attr/themeTextAccent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textColor="?android:attr/textColorPrimary"
                        android:id="@+id/etCustomMessage2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textSize="12sp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/themeTextAccent"
            android:paddingBottom="6dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ  ABOUT"
            android:letterSpacing="0.08"/>
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">
            <LinearLayout
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:id="@+id/tvVersion"
                    android:paddingBottom="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Version 1.3.3"/>
                <com.google.android.material.button.MaterialButton
                    android:textColor="#ff5555"
                    android:id="@+id/btnClearAllData"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="CLEAR ALL DATA"
                    android:backgroundTint="#00000000"
                    app:cornerRadius="8dp"
                    app:strokeColor="#ff5555"
                    app:strokeWidth="1dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
