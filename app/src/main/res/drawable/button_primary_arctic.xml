<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#000000"
                        android:endColor="#007a9e"
                        android:angle="90"
                        android:type="linear"
                        android:centerColor="#010508"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#60000000"
                        android:endColor="#00000000"
                        android:angle="90"
                        android:type="linear"
                        android:centerColor="#20000000"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1dp"
                        android:color="#007a9e"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1a1a1a"
                android:endColor="#1a4a5a"
                android:angle="90"
                android:type="linear"/>
            <stroke
                android:width="1dp"
                android:color="#2a6a7a"/>
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#000000"
                        android:endColor="#00b4d8"
                        android:angle="90"
                        android:type="linear"
                        android:centerColor="#020508"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#55000000"
                        android:endColor="#00000000"
                        android:angle="90"
                        android:type="linear"
                        android:centerColor="#10000000"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#2890f0ff"
                        android:endColor="#00000000"
                        android:angle="270"
                        android:type="linear"
                        android:centerColor="#0890f0ff"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1dp"
                        android:color="#00b4d8"/>
                    <corners android:radius="8dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
