<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#c8d4af37"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#f5f2e8"
                android:endColor="#e8e4d8"
                android:angle="270"
                android:type="linear"
                android:centerColor="#eeeae0"/>
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#20ffffff"
                android:endColor="#00000000"
                android:angle="270"
                android:type="linear"
                android:centerColor="#05ffffff"/>
        </shape>
    </item>
</layer-list>
